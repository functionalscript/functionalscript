{
  "name": "functionalscript",
  "version": "0.59.0",
  "type": "module",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.mjs",
    "**/*.d.mts",
    "!**/private.d.ts"
  ],
  "description": "FunctionalScript is a purely functional subset of JavaScript",
  "scripts": {
    "prepack": "tsc --noEmit false --emitDeclarationOnly && tsc",
    "test": "tsc && node ./fjs/module.mjs t",
    "start": "node ./fjs/module.mjs",
    "sm": "js --module ./fjs/spidermonkey.mjs --",
    "gen:clean": "node ./fjs/module.mjs r ./fjs/dev/clean/module.f.mjs",
    "gen": "node ./fjs/module.mjs r ./fjs/dev/gen/module.f.mjs",
    "lock-update": "mise lock && npm run gen && npm install && deno install && bun install && cargo update",
    "website": "node ./fjs/module.mjs r ./fjs/website/module.f.mjs",
    "rustdoc-bars": "node ./fjs/module.mjs r ./fjs/website/rustdoc-bars/module.f.mjs"
  },
  "engines": {
    "node": "26.13.1"
  },
  "bin": {
    "fjs": "fjs/module.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functionalscript/functionalscript.git"
  },
  "author": "Sergey Shandar",
  "license": "MIT",
  "keywords": [
    "lambda",
    "functional-programming",
    "closure",
    "pure-functional",
    "typescript",
    "programming-language",
    "lazy-evaluation"
  ],
  "bugs": {
    "url": "https://github.com/functionalscript/functionalscript/issues"
  },
  "homepage": "https://github.com/functionalscript/functionalscript#readme",
  "devDependencies": {
    "@types/node": "=26.0.0"
  }
}
