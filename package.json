{
  "name": "functionalscript",
  "version": "0.48.0",
  "type": "module",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.mjs",
    "**/*.d.mts",
    "!**/private.d.ts"
  ],
  "description": "FunctionalScript is a purely functional subset of JavaScript",
  "scripts": {
    "prepack": "tsc --noEmit false --emitDeclarationOnly && tsc",
    "test": "tsc && node ./fjs/module.mjs t",
    "cov": "node --test --experimental-test-coverage --test-coverage-include=**/module.f.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "start": "node ./fjs/module.mjs",
    "ci-update": "node ./fjs/module.mjs ci && node ./fjs/module.mjs r ./fjs/nanvm/update/module.f.mjs",
    "dev-update": "node ./fjs/module.mjs r ./fjs/dev/update/module.f.mjs",
    "update": "npm run ci-update && npm install && deno install && bun install",
    "website": "node ./fjs/module.mjs r ./fjs/website/module.f.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fjs": "fjs/module.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functionalscript/functionalscript.git"
  },
  "author": "Sergey Shandar",
  "license": "MIT",
  "keywords": [
    "lambda",
    "functional-programming",
    "closure",
    "pure-functional",
    "typescript",
    "programming-language",
    "lazy-evaluation"
  ],
  "bugs": {
    "url": "https://github.com/functionalscript/functionalscript/issues"
  },
  "homepage": "https://github.com/functionalscript/functionalscript#readme",
  "devDependencies": {
    "@types/node": "=26.0.0"
  }
}
