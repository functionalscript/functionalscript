{
  "name": "functionalscript",
  "version": "0.43.1",
  "type": "module",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.mjs",
    "**/*.d.mts"
  ],
  "description": "FunctionalScript is a purely functional subset of JavaScript",
  "scripts": {
    "prepack": "tsc --noEmit false --emitDeclarationOnly && tsc --noEmit false --declaration false",
    "test": "tsc && node ./fjs/module.ts t",
    "cov": "node --test --experimental-test-coverage --test-coverage-include=**/module.f.ts --test-coverage-include=**/module.f.mjs",
    "start": "node ./fjs/module.ts",
    "ci-update": "node ./fjs/module.ts ci && node ./fjs/module.ts r ./fjs/nanvm/update/module.f.ts",
    "dev-update": "node ./fjs/module.ts r ./fjs/dev/update/module.f.mjs",
    "update": "npm run ci-update && npm install && deno install && bun install",
    "index-html": "node ./fjs/module.ts r ./fjs/website/module.f.mjs",
    "website": "npm run prepack && npm run index-html"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fjs": "fjs/module.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functionalscript/functionalscript.git"
  },
  "author": "Sergey Shandar",
  "license": "MIT",
  "keywords": [
    "lambda",
    "functional-programming",
    "closure",
    "pure-functional",
    "typescript",
    "programming-language",
    "lazy-evaluation"
  ],
  "bugs": {
    "url": "https://github.com/functionalscript/functionalscript/issues"
  },
  "homepage": "https://github.com/functionalscript/functionalscript#readme",
  "devDependencies": {
    "@types/node": "=26.0.0",
    "typescript": "=7.0.2"
  }
}
