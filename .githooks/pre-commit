#!/bin/sh
set -eu

. "$(dirname "$0")/mcp-hook-lib.sh"

enter_repo_root

SOURCE=".copilot/mcp.json"
TARGET=".vscode/mcp.json"

source_staged="$(git diff --cached --name-only -- "$SOURCE" | wc -l | tr -d ' ')"
source_unstaged="$(git diff --name-only -- "$SOURCE" | wc -l | tr -d ' ')"
target_staged="$(git diff --cached --name-only -- "$TARGET" | wc -l | tr -d ' ')"
target_unstaged="$(git diff --name-only -- "$TARGET" | wc -l | tr -d ' ')"

if [ "$source_staged" -eq 0 ] && [ "$source_unstaged" -eq 0 ]; then
  if [ "$target_staged" -gt 0 ] || [ "$target_unstaged" -gt 0 ]; then
    echo "ERROR: $TARGET was edited directly."
    echo "Edit $SOURCE only, then commit."
    exit 1
  fi
fi

if [ "$source_staged" -gt 0 ]; then
  staged_source="$(mktemp)"
  trap 'rm -f "$staged_source"' EXIT HUP INT TERM
  git show ":$SOURCE" > "$staged_source"
  staged_source_for_powershell="$staged_source"
  if command -v cygpath >/dev/null 2>&1; then
    staged_source_for_powershell="$(cygpath -w "$staged_source")"
  fi
  if run_powershell "./scripts/sync-mcp.ps1" -Mode sync -SourceFile "$staged_source_for_powershell"; then
    sync_status=0
  else
    sync_status=$?
  fi
else
  if run_powershell "./scripts/sync-mcp.ps1" -Mode sync; then
    sync_status=0
  else
    sync_status=$?
  fi
fi

if [ "$sync_status" -eq 127 ]; then
  echo "ERROR: pwsh or powershell is required to sync MCP config." >&2
  exit 1
fi

if [ "$sync_status" -ne 0 ]; then
  echo "ERROR: MCP sync failed. Run .\\scripts\\sync-mcp.ps1 -Mode sync and try again." >&2
  exit 1
fi

git add -f -- "$TARGET"
