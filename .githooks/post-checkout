#!/bin/sh
set -eu

. "$(dirname "$0")/mcp-hook-lib.sh"

enter_repo_root

if [ -f "./scripts/sync-mcp.ps1" ]; then
  if ! run_powershell "./scripts/sync-mcp.ps1" -Mode sync >/dev/null; then
    echo "WARN: MCP sync failed after checkout; edit .copilot/mcp.json and run the sync script manually." >&2
  fi
fi
