* text eol=lf

# Binary: an .ico embeds a PNG's magic bytes, which include a CRLF the text
# rule above would silently rewrite to LF, corrupting the file on checkout.
*.ico binary

# Generated: every file or directory whose name starts with `gen.`. Two
# lines, because an attribute on a directory does not reach the files inside
# it. See CONTRIBUTING.md, "Naming generated files".
gen.* linguist-generated=true
**/gen.*/** linguist-generated=true

# Generated too, under the name its tool requires: the devcontainer CLI writes
# this lock from `.devcontainer/devcontainer.json` in `npm run lock-update`.
.devcontainer/devcontainer-lock.json linguist-generated=true
